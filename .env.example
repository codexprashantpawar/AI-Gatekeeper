# Copy to .env and edit
CAMERA_URL=http://192.0.0.2:8080
CAMERA_ID=PHONE-01
# Vehicle + animal model (Hugging Face, Apache-2.0)
HF_OBJECT_MODEL=PekingU/rtdetr_r50vd
# Plate detector weights (your cloned HF repo)
PLATE_WEIGHTS=C:\path\to\best.pt
CONF_OBJECTS=0.5
CONF_PLATE=0.4
COOLDOWN_SECONDS=10
OUTPUT_DIR=output
LOCAL_TZ_OFFSET_HOURS=5.5
